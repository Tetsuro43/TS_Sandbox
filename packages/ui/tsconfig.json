{
  "extends": "../../tsconfig.json", // 親設定を継承
  "compilerOptions": {
    /* React & Browser Setup */
    "lib": ["ES2022", "DOM", "DOM.Iterable"], // ブラウザ機能ON
    "jsx": "react-jsx",                       // React ON
    "noEmit": false,             // 出力ON
    "emitDeclarationOnly": true, // JSはNext.jsが出すので、TSは型定義だけ出す
    "composite": true,           // ルートから参照されるために必要
    "declaration": true,         // 型定義出力
    "declarationMap": true,      // ソースマップ

    "module": "esnext",           // 最新のECMAScript仕様
    "moduleResolution": "bundler", // バンドラ(Vite)が解決するから拡張子省略を許してね、という設定
  },
  "include": ["src/**/*"]
}